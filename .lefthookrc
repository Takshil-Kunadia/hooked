# Sourced by lefthook before every hook: use the project's Node (.nvmrc) even when
# the shell's default Node is older, so hooks behave the same for everyone.
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  . "$NVM_DIR/nvm.sh" >/dev/null 2>&1
  nvm use >/dev/null 2>&1 || true
fi
